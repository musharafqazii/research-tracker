rules_version = '2';
// Only these Google accounts can read or write the tracker. Put your own address and your guide's here,
// then paste this file into Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
          && request.auth.token.email in [
               'musharafqazi@physics.iitm.ac.in',
               'garani@physics.iitm.ac.in'
             ];
    }
    // one document per project: the ticks
    match /trackers/{project} {
      allow read, write: if allowed();
      // comments: anyone on the list reads and adds; only the author deletes their own
      match /comments/{comment} {
        allow read: if allowed();
        allow create: if allowed() && request.resource.data.by == request.auth.uid;
        allow delete: if allowed() && resource.data.by == request.auth.uid;
      }
      // meetings: anyone on the list reads, proposes, confirms/declines or removes (just the two of you)
      match /meetings/{meeting} {
        allow read: if allowed();
        allow create: if allowed() && request.resource.data.by == request.auth.uid;
        allow update, delete: if allowed();
      }
      // decisions and questions: anyone on the list reads and adds; either can mark one resolved/answered
      match /decisions/{decision} {
        allow read: if allowed();
        allow create: if allowed() && request.resource.data.by == request.auth.uid;
        allow update: if allowed();
      }
      match /questions/{question} {
        allow read: if allowed();
        allow create: if allowed() && request.resource.data.by == request.auth.uid;
        allow update: if allowed();
      }
      // daily research log: anyone on the list reads and adds; entries are not edited or deleted
      match /logs/{entry} {
        allow read: if allowed();
        allow create: if allowed() && request.resource.data.by == request.auth.uid;
      }
    }
  }
}
